DB_URL=jdbc:postgresql://localhost:5432/mentesvivas
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gere com: openssl rand -base64 64 (minimo 256 bits)
JWT_SECRET=
JWT_ISSUER=mentesvivas
# Validade do access token (JWT); o app usa o refresh token para renovar
JWT_ACCESS_TOKEN_EXPIRATION=30m
# Duracao da sessao: refresh token expira apos 1h sem uso (RN06)
JWT_SESSION_EXPIRATION=1h

# Bloqueio apos 5 tentativas invalidas (RN05). Valores a definir com o time (pendente)
LOGIN_JANELA_TENTATIVAS=15m
LOGIN_DURACAO_BLOQUEIO=15m

# Administrador inicial: criado na primeira subida (senha minima de 12 caracteres)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
