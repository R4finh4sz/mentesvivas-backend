DB_URL=jdbc:postgresql://localhost:5432/mentesvivas
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Gere com: openssl rand -base64 64 (minimo 256 bits)
JWT_SECRET=
JWT_ISSUER=mentesvivas
# Validade do access token (JWT); o app usa o refresh token para renovar
JWT_ACCESS_TOKEN_EXPIRATION=30m
# Duracao da sessao: refresh token expira apos 1h sem uso (RN06)
JWT_SESSION_EXPIRATION=1h

# Bloqueio apos 5 tentativas invalidas (RN05). Valores a definir com o time (pendente)
LOGIN_ATTEMPTS_WINDOW=15m
LOGIN_LOCKOUT_DURATION=15m

# E-mail via Resend (RN10). Sem chave, o envio fica desabilitado
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=MentesVivas <onboarding@resend.dev>

# Recuperacao de senha (RN10). Validade proposta no rascunho: 30m; limites a definir
RECOVERY_CODE_VALIDITY=30m
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_MAX_SENDS=3
RECOVERY_SENDS_WINDOW=1h

# Confirmacao de e-mail (RN30). Validade e limites a definir
EMAIL_CONFIRMATION_CODE_VALIDITY=30m
EMAIL_CONFIRMATION_MAX_ATTEMPTS=5
EMAIL_CONFIRMATION_MAX_SENDS=3
EMAIL_CONFIRMATION_SENDS_WINDOW=1h

# Segundo fator do medico por e-mail (RN04). Validade e limites a definir
TWO_FACTOR_CODE_VALIDITY=10m
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_MAX_SENDS=5
TWO_FACTOR_SENDS_WINDOW=1h

# Busca de CEP (ViaCEP, RN17). Se falhar, o endereco e preenchido manualmente
CEP_BASE_URL=https://viacep.com.br/ws
CEP_TIMEOUT=3s

# Administrador inicial: criado na primeira subida (senha minima de 12 caracteres)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Faixas de peso (kg) e altura (m), RN22: expected pede confirmacao e possible bloqueia. Valores a validar com os medicos
WEIGHT_EXPECTED_MIN=30
WEIGHT_EXPECTED_MAX=300
WEIGHT_POSSIBLE_MIN=10
WEIGHT_POSSIBLE_MAX=500
HEIGHT_EXPECTED_MIN=1.20
HEIGHT_EXPECTED_MAX=2.30
HEIGHT_POSSIBLE_MIN=0.50
HEIGHT_POSSIBLE_MAX=2.80
